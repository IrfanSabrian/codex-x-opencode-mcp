{
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "blocked",
        "failed",
        "cancelled",
        "partial"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "what_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "typecheck": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "lint": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "tests": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "build": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "custom_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "typecheck",
        "lint",
        "tests",
        "build",
        "custom_checks"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "decision_id",
          "question",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "capabilities_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities_installed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agents_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "models_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcps_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcp_state": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "task_id",
    "status",
    "summary",
    "what_changed",
    "changed_files",
    "artifacts",
    "validation",
    "evidence",
    "risks",
    "assumptions",
    "unresolved_issues",
    "decisions_required",
    "capabilities_used",
    "capabilities_installed",
    "agents_used",
    "models_used",
    "tools_used",
    "mcps_used",
    "mcp_state",
    "provenance"
  ],
  "additionalProperties": false
}
