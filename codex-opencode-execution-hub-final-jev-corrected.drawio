    <diagram id="09a-omo-detailed-delegation-5f4863" name="09A OMO Detailed Delegation">
        <mxGraphModel dx="1255" dy="856" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;09A — OMO Internal Agent Graph &amp;amp; Subagent Delegation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;Detailed view of what happens after Jev routes a task into OMO.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="c1" value="&lt;b&gt;OPEN CODE HANDOFF&lt;/b&gt;&lt;br&gt;Jev output reaches OMO with:&lt;br&gt;complexity • ultrawork • skill • load_skills • task constraints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="185" width="280" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c2" value="&lt;b&gt;PROMETHEUS&lt;/b&gt;&lt;br&gt;Agent assignment planner&lt;br&gt;Model: Muse Spark 1.3&lt;br&gt;&lt;br&gt;Divides Codex-approved work into bounded assignments for configured agents. Does not change objective, scope, architecture, or acceptance criteria." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F7CFF;strokeColor=#4F7CFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="480" y="180" width="230" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c3" value="&lt;b&gt;ATLAS&lt;/b&gt;&lt;br&gt;Orchestration / conductor&lt;br&gt;Model: configured Lightning&lt;br&gt;&lt;br&gt;Coordinates execution and delegation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="830" y="180" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c4" value="&lt;b&gt;SISYPHUS&lt;/b&gt;&lt;br&gt;Lead executor&lt;br&gt;Model: Muse Spark 1.3&lt;br&gt;&lt;br&gt;Owns main implementation loop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A45;strokeColor=#FF7A45;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1160" y="185" width="250" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c5" value="&lt;b&gt;SUBAGENT BRANCHES&lt;/b&gt;&lt;br&gt;Explore → repository discovery&lt;br&gt;Librarian → docs / knowledge&lt;br&gt;Oracle / Metis → analysis / planning&lt;br&gt;Hephaestus → specialist implementation&lt;br&gt;Reviewer / Tester → quality / regression" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="790" y="420" width="320" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c6" value="&lt;b&gt;DELEGATION RULE&lt;/b&gt;&lt;br&gt;Parent agent passes only the context needed by the child:&lt;br&gt;task slice + relevant files + constraints + loaded skills + expected output.&lt;br&gt;&lt;br&gt;Codex private reasoning is NOT copied wholesale into every subagent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="490" width="320" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="c7" value="&lt;b&gt;PARALLEL / SEQUENTIAL&lt;/b&gt;&lt;br&gt;Independent investigation can run in parallel.&lt;br&gt;&lt;br&gt;Implementation waits for required findings.&lt;br&gt;&lt;br&gt;Reviewer receives the actual diff / result, not only a verbal summary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F0;strokeColor=#B9E8CB;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="340" width="310" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c8" value="&lt;b&gt;OMO OUTPUT&lt;/b&gt;&lt;br&gt;Integrated implementation + agent findings + validation + unresolved decisions → OpenCode Result Contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="435" y="650" width="1030" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ce1" value="orchestrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="c1" target="c2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce2" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="c2" target="c3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce3" value="assign lead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="c3" target="c4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce4" value="delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="c3" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce5" value="findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="c5" target="c4" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1285" y="480"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ce6" value="integrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" parent="1" source="c4" target="c8" edge="1">
                    <mxGeometry x="0.2771" relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1347" y="550"/>
                            <mxPoint x="1207" y="550"/>
                        </Array>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ce7" value="review / findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="c5" target="c8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce8" value="execution strategy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="c7" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ce9" value="delegation contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="c6" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="09b-agent-lifecycle-4df5e7" name="09B Agent Lifecycle">
        <mxGraphModel dx="1334" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;09B — Agent Lifecycle: Context → Action → Delegation → Validation → Report&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;Shows the execution lifecycle inside OMO and prevents confusion between subtask completion and overall task completion.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="d1" value="&lt;b&gt;1. AGENT CREATED / INVOKED&lt;/b&gt;&lt;br&gt;Agent identity + its configured model + permissions become active." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F7CFF;strokeColor=#4F7CFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="160" width="310" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="d2" value="&lt;b&gt;2. CONTEXT ASSEMBLY&lt;/b&gt;&lt;br&gt;Execution Brief slice + project AGENTS.md + loaded SKILL.md + relevant workspace facts + allowed tools/MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="450" y="150" width="330" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="d3" value="&lt;b&gt;3. REASON / ACT&lt;/b&gt;&lt;br&gt;Agent inspects, plans locally, uses tools, edits files or produces artifacts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A45;strokeColor=#FF7A45;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="860" y="155" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="d4" value="&lt;b&gt;4. DELEGATE WHEN NEEDED&lt;/b&gt;&lt;br&gt;Agent can call appropriate subagents under OMO rules; each receives a bounded task slice." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="150" width="310" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="d5" value="&lt;b&gt;5. VALIDATE&lt;/b&gt;&lt;br&gt;Run task-specific tests and skill-mandated validation. Collect evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1225" y="490" width="300" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="d6" value="&lt;b&gt;6. REPORT&lt;/b&gt;&lt;br&gt;Return findings, changes, evidence, risks, unresolved issues, and artifacts to the parent agent / OpenCode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="830" y="510" width="290" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="d7" value="&lt;b&gt;7. PARENT INTEGRATES&lt;/b&gt;&lt;br&gt;Parent agent reviews child output and decides whether to continue, delegate again, or package the result." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="450" y="430" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="d8" value="&lt;b&gt;AGENT END CONDITION&lt;/b&gt;&lt;br&gt;Agent does not declare the whole user task complete merely because its local subtask succeeded. Completion remains governed by the parent execution contract and ultimately Codex quality gate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD3DC;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="650" width="1460" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="de1" value="load" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="d1" target="d2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de2" value="execute" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="d2" target="d3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="de3" value="delegate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="d3" target="d4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
