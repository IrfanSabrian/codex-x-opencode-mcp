    <diagram id="08a-jev-decision-detail-25ab7a" name="08A Jev Decision Detail">
        <mxGraphModel dx="1343" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;08A — Jev Decision Detail &amp;amp; Thresholds&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;Jev decides routing cheaply before OpenCode invokes the agent/orchestration path.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="a1" value="&lt;b&gt;JEV INPUT&lt;/b&gt;&lt;br&gt;Execution Brief + workspace facts + project context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="185" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="a2" value="&lt;b&gt;COMPLEXITY&lt;/b&gt;&lt;br&gt;quick / standard / full / specialist&lt;br&gt;&lt;br&gt;Confidence 0–1&lt;br&gt;&amp;gt;0.85 auto-act&lt;br&gt;0.60–0.85 act with default&lt;br&gt;&amp;lt;0.60 fallback / expensive decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F7CFF;strokeColor=#4F7CFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="420" y="125" width="300" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="a3" value="&lt;b&gt;ULTRAWORK&lt;/b&gt;&lt;br&gt;need_ultrawork &amp;gt; 0.60 OR complexity = full/specialist&lt;br&gt;&lt;br&gt;yes → OMO orchestration&lt;br&gt;no + quick → direct" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A45;strokeColor=#FF7A45;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="780" y="125" width="300" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="a4" value="&lt;b&gt;VISUAL&lt;/b&gt;&lt;br&gt;is_visual &amp;gt; 0.55 → visual-engineering route&lt;br&gt;&lt;br&gt;Visual route uses Mimo-family configuration and frontend skill path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="125" width="360" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="a5" value="&lt;b&gt;PRIMARY SKILL / ROUTE&lt;/b&gt;&lt;br&gt;Jev classifies the task into a primary skill route:&lt;br&gt;frontend • backend-architect • security-research • bug-hunter • playwright • API security • AutoCAD router • etc.&lt;br&gt;&lt;br&gt;The selected route identifies a predefined skill bundle; Jev is not independently selecting each supporting skill." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="420" y="420" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="a6" value="&lt;b&gt;DECISION OUTPUT&lt;/b&gt;&lt;br&gt;complexity&lt;br&gt;ultrawork yes/no&lt;br&gt;visual yes/no&lt;br&gt;primary skill / route&lt;br&gt;resolved skill bundle / load_skills&lt;br&gt;execution category" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1170" y="420" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="a7" value="&lt;b&gt;ROUTING EXAMPLE&lt;/b&gt;&lt;br&gt;quick + bug-hunter → Sisyphus direct&lt;br&gt;&lt;br&gt;full + backend-architect → OMO / deep route&lt;br&gt;&lt;br&gt;specialist → ultrabrain + ultrawork" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="740" y="610" width="360" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="ae1" value="analyze" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a1" target="a2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae2" value="evaluate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a2" target="a3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae3" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a3" target="a4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae4" value="classify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a2" target="a5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae5" value="produce" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a5" target="a6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae6" value="force route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="a4" target="a6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ae7" value="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="a6" target="a7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="08b-jev-skill-expansion-ef2c77" name="08B Jev Skill Expansion">
        <mxGraphModel dx="1555" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;08B — Jev Primary Skill → Skill Bundle → load_skills&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;The key relationship: Jev selects one primary skill route; that route maps to a predefined bundle of SKILL.md files, which are loaded together into the agent execution context.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="&lt;b&gt;1. PRIMARY SKILL / ROUTE SELECTED BY JEV&lt;/b&gt;&lt;br&gt;Example: &lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Jev's decision is the route/category &lt;b&gt;frontend&lt;/b&gt;, not a separate selection of every supporting skill." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F7CFF;strokeColor=#4F7CFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="110" y="154" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="&lt;b&gt;3. OTHER COMPOSITE ROUTES&lt;/b&gt;&lt;br&gt;&lt;b&gt;backend-architect&lt;/b&gt; → backend-architect, nodejs-backend-patterns, nodejs-best-practices, api-design-principles, architecture&lt;br&gt;&lt;br&gt;&lt;b&gt;bug-hunter&lt;/b&gt; → bug-hunter, debugging-strategies, lint-and-validate, code-review-checklist&lt;br&gt;&lt;br&gt;&lt;span style='color:#607080'&gt;The route selects the bundle as a unit.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="110" width="310" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="&lt;b&gt;4. SECURITY / TESTING BUNDLES&lt;/b&gt;&lt;br&gt;&lt;b&gt;security-research&lt;/b&gt; → security-research, security-best-practices, security-threat-model, security-ownership-map, code-review-checklist&lt;br&gt;&lt;br&gt;&lt;b&gt;playwright&lt;/b&gt; → playwright, playwright-interactive&lt;br&gt;&lt;br&gt;&lt;b&gt;api-security-testing&lt;/b&gt; → api-security-testing, owasp-top-10-testing, find-security-vulnerabilities-in-code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="520" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="&lt;b&gt;5. SPECIALIST ROUTES&lt;/b&gt;&lt;br&gt;&lt;b&gt;penetration-testing-with-strix&lt;/b&gt; → pentest skill set + OWASP/application-security/web-app testing&lt;br&gt;&lt;br&gt;&lt;b&gt;autocad-router&lt;/b&gt; → autocad-router, autocad-universal-cad, bang-motion&lt;br&gt;&lt;br&gt;&lt;b&gt;nodejs-backend-patterns&lt;/b&gt; → nodejs-backend-patterns, api-design-principles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="460" y="254" width="430" height="156" as="geometry"/>
                </mxCell>
                <mxCell id="b6" value="&lt;b&gt;6. LOAD_SKILLS&lt;/b&gt;&lt;br&gt;After the primary route is selected and its bundle is resolved, OpenCode loads the corresponding &lt;b&gt;SKILL.md&lt;/b&gt; files listed in &lt;b&gt;load_skills&lt;/b&gt;.&lt;br&gt;&lt;br&gt;The complete loaded bundle becomes part of the agent execution context together with project instructions, &lt;b&gt;AGENTS.md&lt;/b&gt;, and the Execution Brief." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="360" width="510" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="b7" value="&lt;b&gt;7. BUNDLE CONTENT CAN CONTAIN WORKFLOW RULES&lt;/b&gt;&lt;br&gt;Example: the &lt;b&gt;bug-hunter&lt;/b&gt; bundle includes &lt;b&gt;lint-and-validate&lt;/b&gt; as a mandatory validation component.&lt;br&gt;&lt;br&gt;Node → eslint, tsc, npm audit (high)&lt;br&gt;Python → ruff, bandit, mypy&lt;br&gt;&lt;br&gt;Failure means the task is not done; produce the final audit report." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD3DC;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="350" y="740" width="530" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="b8" value="&lt;b&gt;8. CORRECT FLOW&lt;/b&gt;&lt;br&gt;Jev task classification&lt;br&gt;↓&lt;br&gt;&lt;b&gt;Primary Skill / Route&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;&lt;b&gt;Predefined Skill Bundle&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;&lt;b&gt;load_skills&lt;/b&gt;&lt;br&gt;↓&lt;br&gt;SKILL.md retrieval / loading&lt;br&gt;↓&lt;br&gt;Agent execution context&lt;br&gt;↓&lt;br&gt;Agent / OMO execution&lt;br&gt;↓&lt;br&gt;Validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="630" width="170" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="be1" value="select route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="335" y="440"/>
                            <mxPoint x="765" y="440"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="be2" value="resolve bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b1" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="be3" value="resolve bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="b1" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="be4" value="resolve bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="b1" target="b5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="be5" value="load bundle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="b2" target="b6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
