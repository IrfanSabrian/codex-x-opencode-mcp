                <mxCell id="95" value="&lt;b&gt;1. INTAKE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;validasi format • cek task ID • cek acceptance • workspace_root absolut + directory ada (fail-closed)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#11A683;strokeColor=#11A683;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
