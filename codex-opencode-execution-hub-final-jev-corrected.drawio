    <diagram id="page19" name="19 Bridge Contract &amp; Token Policy">
        <mxGraphModel dx="1555" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p19t" value="&lt;b style='font-size:22px'&gt;19 — Bridge Contract &amp; Token Policy&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;Detailed Codex-facing MCP interface: enough control for quality, without exposing OpenCode's entire internal tool graph&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#203040;align=left;verticalAlign=middle;spacing=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="p19codex" value="&lt;b&gt;CODEX&lt;/b&gt;&lt;br&gt;Produces Execution Brief once.&lt;br&gt;Receives compact result first.&lt;br&gt;Requests deeper data only when necessary." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFF;strokeColor=#6D4AFF;fontColor=#302060;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="70" y="150" width="280" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="p19bridge" value="&lt;b&gt;OPEN CODE MCP BRIDGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;7 public tools&lt;/b&gt;&lt;br&gt;execute • status • result • inspect • correct • decision • stop&lt;br&gt;&lt;br&gt;Internal Jev/OMO/skill/MCP operations remain hidden." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#4F7CFF;fontColor=#203040;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="480" y="135" width="420" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p19runtime" value="&lt;b&gt;OPENCODE RUNTIME&lt;/b&gt;&lt;br&gt;&lt;br&gt;Jev → skill route → predefined skill bundle → load_skills → OMO/direct agent → task-scoped MCP → validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F4;strokeColor=#11A683;fontColor=#20483D;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1135" y="135" width="420" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="p19e1" value="Execution Brief" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#607080;" parent="1" source="p19codex" target="p19bridge" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p19e2" value="task_id / task state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#607080;" parent="1" source="p19bridge" target="p19runtime" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p19tools" value="&lt;b&gt;TOOL 1 — opencode_execute&lt;/b&gt;&lt;br&gt;Input: full structured Execution Brief.&lt;br&gt;Output: task_id + accepted state.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOOL 2 — opencode_status&lt;/b&gt;&lt;br&gt;Compact lifecycle / attention state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#607080;fontColor=#203040;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="390" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p19inspect" value="&lt;b&gt;TOOL 3 — opencode_result&lt;/b&gt;&lt;br&gt;Compact Result Contract summary.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOOL 4 — opencode_inspect&lt;/b&gt;&lt;br&gt;Lazy retrieval views: diff, files, validation, artifacts, evidence, decision, logs, provenance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#607080;fontColor=#203040;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="390" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p19loop" value="&lt;b&gt;TOOL 5 — opencode_correct&lt;/b&gt;&lt;br&gt;Correction delta; references existing task_id.&lt;br&gt;&lt;br&gt;&lt;b&gt;TOOL 6 — opencode_decision&lt;/b&gt;&lt;br&gt;Codex resolves explicit architecture/risk decision." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#607080;fontColor=#203040;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="50" y="390" width="430" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="p19stop" value="&lt;b&gt;TOOL 7 — opencode_stop&lt;/b&gt;&lt;br&gt;Cancel/stop running task.&lt;br&gt;&lt;br&gt;&lt;b&gt;INTERNAL ONLY&lt;/b&gt;&lt;br&gt;Capability registry, MCP discovery, skill loading, Jev, OMO and agent start/stop are not separately exposed to Codex." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#F5A623;fontColor=#6A4A12;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="600" y="630" width="430" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p19token" value="&lt;b&gt;TOKEN-EFFICIENT RETRIEVAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Send Execution Brief once.&lt;br&gt;2. Reuse task_id.&lt;br&gt;3. Default status/result = compact.&lt;br&gt;4. Retrieve large payloads only via inspect(view).&lt;br&gt;5. Correction sends only delta, not the entire brief.&lt;br&gt;6. Bridge stores IDs/state/metadata, not duplicated transcript." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF8F4;strokeColor=#11A683;fontColor=#20483D;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="630" width="430" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p19boundary" value="&lt;b&gt;AUTHORITY BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;Codex: task / objective / architecture / acceptance / final decision + workspace_root absolut per task.&lt;br&gt;OpenCode: execution / tools / validation inside that workspace only.&lt;br&gt;Prometheus: bounded agent assignments only.&lt;br&gt;Jev + OMO: routing / orchestration within Codex boundaries.&lt;br&gt;Agents: scoped execution using configured models.&lt;br&gt;MCPs: capabilities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EAFF;strokeColor=#6D4AFF;fontColor=#302060;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="50" y="630" width="430" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="p19e3" value="internal execution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#607080;" parent="1" source="p19runtime" target="p19tools" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p19e4" value="Result Contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#607080;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" parent="1" source="p19runtime" target="p19inspect" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
