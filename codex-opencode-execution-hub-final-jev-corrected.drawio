    <diagram id="10a-agent-context-assembly-7a6308" name="10A Agent Context Assembly">
        <mxGraphModel dx="1642" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;10A — OpenCode Agent Context Assembly&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;How OpenCode turns Codex decisions + Jev + skills + project rules + tools into the bounded context an agent actually receives.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="&lt;b&gt;EXECUTION BRIEF&lt;/b&gt;&lt;br&gt;Goal • architecture • decisions • constraints • acceptance • required capabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F7CFF;strokeColor=#4F7CFF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="140" width="290" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="&lt;b&gt;PROJECT INSTRUCTIONS&lt;/b&gt;&lt;br&gt;AGENTS.md / repository rules / skill usage policy / model assignment / prompt integrity / validation rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="430" y="240" width="290" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="&lt;b&gt;JEV OUTPUT&lt;/b&gt;&lt;br&gt;complexity • ultrawork • visual • selected skill • expanded load_skills" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A45;strokeColor=#FF7A45;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="750" width="270" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="&lt;b&gt;SKILL FILES&lt;/b&gt;&lt;br&gt;Load the exact SKILL.md files selected by the routing layer.&lt;br&gt;&lt;br&gt;Example bug-hunter bundle: debugging + validation + review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="150" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="&lt;b&gt;AGENT PROFILE&lt;/b&gt;&lt;br&gt;Agent identity&lt;br&gt;Configured model&lt;br&gt;Permissions&lt;br&gt;Allowed tool / MCP surface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="150" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="e6" value="&lt;b&gt;WORKSPACE FACTS&lt;/b&gt;&lt;br&gt;Relevant files, git state, existing implementation, test output, prior findings. Retrieve only what the current task needs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="570" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="e7" value="&lt;b&gt;TOOL / MCP CONTEXT&lt;/b&gt;&lt;br&gt;Only task-relevant capabilities are exposed. Heavy or specialist MCPs remain dormant unless required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="30" y="360" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="e8" value="&lt;b&gt;AGENT EXECUTION CONTEXT&lt;/b&gt;&lt;br&gt;Bounded context assembled from all layers above.&lt;br&gt;&lt;br&gt;This is what the agent actually reasons over." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1030" y="390" width="400" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="e9" value="&lt;b&gt;PRINCIPLE&lt;/b&gt;&lt;br&gt;Do not copy the entire Codex conversation or private chain-of-thought into every agent. Pass decisions and task-relevant evidence instead." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD3DC;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="180" y="750" width="840" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ee1" value="brief" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" parent="1" source="e1" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="940" y="215"/>
                            <mxPoint x="940" y="438"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ee2" value="instructions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;" parent="1" source="e2" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee3" value="routing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" parent="1" source="e3" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee4" value="skills" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="e4" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee5" value="agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" source="e5" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee6" value="facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" parent="1" source="e6" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee7" value="tools" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="e7" target="e8" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ee8" value="bounded context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5B6573;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="e8" target="e9" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
