                <mxCell id="b2" value="&lt;b&gt;2. FRONTEND SKILL BUNDLE&lt;/b&gt;&lt;br&gt;&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;├─ frontend&lt;br&gt;├─ frontend-design&lt;br&gt;├─ design-taste-frontend&lt;br&gt;├─ impeccable&lt;br&gt;├─ hallmark&lt;br&gt;├─ baseline-ui&lt;br&gt;├─ ui-ux-pro-max&lt;br&gt;├─ tailwind-css-patterns&lt;br&gt;├─ antislop&lt;br&gt;└─ antislop-ui&lt;br&gt;&lt;br&gt;These entries belong to the predefined frontend bundle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="600" y="480" width="330" height="230" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
