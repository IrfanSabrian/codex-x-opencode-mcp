                </mxCell>
                <mxCell id="186" value="&lt;b&gt;Reviewer / Tester&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;configured model: MiMo / Lightning (configured)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2F80ED;strokeColor=#2F80ED;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
