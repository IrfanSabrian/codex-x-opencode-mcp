    </diagram>
    <diagram id="10b-subagent-context-boundary-beabad" name="10B Subagent Context Boundary">
        <mxGraphModel dx="1067" dy="728" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;b style='font-size:22px'&gt;10B — Parent → Subagent Context Boundary&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px;color:#607080'&gt;Shows how OMO agents should delegate bounded subtasks instead of forwarding the entire conversation.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#DDE3EA;fontColor=#1E2630;fontSize=16;align=left;verticalAlign=top;spacing=10;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="40" y="25" width="1520" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="f1" value="&lt;b&gt;PARENT AGENT&lt;/b&gt;&lt;br&gt;Sisyphus / specialist parent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF7A45;strokeColor=#FF7A45;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="80" y="175" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="f2" value="&lt;b&gt;SUBTASK CONTRACT&lt;/b&gt;&lt;br&gt;Goal&lt;br&gt;Relevant files&lt;br&gt;Constraints&lt;br&gt;Required skill subset&lt;br&gt;Expected output&lt;br&gt;Validation needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#B8C7FF;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="480" y="155" width="260" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="f3" value="&lt;b&gt;SUBAGENT&lt;/b&gt;&lt;br&gt;Explore / Librarian / Oracle / Hephaestus / Reviewer / etc.&lt;br&gt;&lt;br&gt;Uses its own configured model and allowed tools." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7B61FF;strokeColor=#7B61FF;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="880" y="150" width="290" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="f4" value="&lt;b&gt;SUBAGENT RESULT&lt;/b&gt;&lt;br&gt;Findings&lt;br&gt;Evidence&lt;br&gt;Changed files (if any)&lt;br&gt;Validation&lt;br&gt;Unresolved issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E9E5A;strokeColor=#1E9E5A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="1280" y="160" width="250" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="f5" value="&lt;b&gt;PARENT DECISION&lt;/b&gt;&lt;br&gt;Integrate&lt;br&gt;Reject&lt;br&gt;Ask another agent&lt;br&gt;Request more evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F8B8D;strokeColor=#0F8B8D;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=8;arcSize=12;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="860" y="350" width="360" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="f6" value="&lt;b&gt;BOUNDARY&lt;/b&gt;&lt;br&gt;Subagent does not inherit unlimited parent context by default.&lt;br&gt;Give the smallest useful task slice that preserves correctness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EA;strokeColor=#FFC7B3;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
                    <mxGeometry x="55" y="510" width="350" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="f7" value="&lt;b&gt;WHY THIS MATTERS&lt;/b&gt;&lt;br&gt;Less context noise • lower token use • clearer ownership • easier debugging • safer parallel execution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#CBD3DC;fontColor=#1E2630;fontSize=11;align=left;verticalAlign=top;spacing=10;arcSize=10;shadow=0;" parent="1" vertex="1">
